{
  "name": "tekmerion-audit-view",
  "private": true,
  "version": "0.1.0",
  "description": "The tekmerion audit view: an MCP App and a standalone page for audit reports.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen-types": "node scripts/gen-types.mjs",
    "typecheck": "npm run gen-types && tsc --noEmit",
    "test": "npm run gen-types && vitest run",
    "build": "npm run gen-types && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
